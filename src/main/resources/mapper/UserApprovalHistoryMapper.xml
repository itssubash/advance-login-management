<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.yenyasoft.admin_user_management.mapper.UserApprovalHistoryMapper">

    <resultMap id="approvalHistoryResultMap" type="com.yenyasoft.admin_user_management.models.UserApprovalHistory">
        <id property="approvalId" column="approval_id"/>
        <result property="action" column="action"
                javaType="com.yenyasoft.admin_user_management.enums.UserAction"/>
        <result property="reason" column="reason"/>
        <result property="performedBy" column="performed_by"/>
        <result property="performedAt" column="performed_at"/>
        <association property="user" column="user_id"
                     javaType="com.yenyasoft.admin_user_management.models.User"
                     select="com.yenyasoft.admin_user_management.mapper.UserMapper.findById"/>
    </resultMap>

    <sql id="approvalColumns">
        approval_id, user_id, action, reason, performed_by, performed_at
    </sql>

    <select id="findById" resultMap="approvalHistoryResultMap">
        select <include refid="approvalColumns"/>
        from user_approval_history_table
        where approval_id = #{approvalId}
    </select>

    <select id="findByUserId" resultMap="approvalHistoryResultMap">
        select <include refid="approvalColumns"/>
        from user_approval_history_table
        where user_id = #{userId}
        order by performed_at desc
    </select>

    <select id="findAllApprovalHistory" resultMap="approvalHistoryResultMap">
        select <include refid="approvalColumns"/>
        from user_approval_history_table
        order by performed_at desc
    </select>

    <select id="findByAction" resultMap="approvalHistoryResultMap">
        select <include refid="approvalColumns"/>
        from user_approval_history_table
        where action = #{action}
        order by performed_at desc
    </select>

    <select id="countByAction" resultType="long">
        select count(*)
        from user_approval_history_table
        where action = #{action}
    </select>

</mapper>
